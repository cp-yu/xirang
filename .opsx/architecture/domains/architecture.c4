model {
  architecture = domain 'Architecture' {
      description 'LikeC4 架构模型读取、语义验证和 delta 合并'
      metadata {
        boundary '拥有 LikeC4 file I/O、OPSX semantic validation 与 architecture delta merge'
        status 'active'
      }

      likec4_reader = capability 'LikeC4 Reader' {
        description '读取 versioned OPSX LikeC4 graph modules，解析任意 element kinds、stable elementId、containment、relationships、Metamodel 与 views'
                metadata {
          capabilityId 'cap.architecture.likec4-reader'
          status 'active'
          specs ['.opsx/specs/arch-query-command/spec.md']
        }
      }

      semantic_validator = capability 'Semantic Validator' {
        description '验证 Project Root、element identity、abstraction/refinement containment、Metamodel constraints、Element Contracts 与 semantic relationships'
                metadata {
          capabilityId 'cap.architecture.semantic-validator'
          status 'active'
          specs ['.opsx/specs/likec4-semantic-validator/spec.md']
        }
      }

      delta_merger = capability 'Architecture Delta Merger' {
        description '将 graph delta 与 element-owned Spec deltas 作为一个 Semantic Delta 原子 reconcile 到 formal OPSX Semantic Model'
                metadata {
          capabilityId 'cap.architecture.delta-merger'
          status 'active'
          specs ['.opsx/specs/architecture-delta-artifact/spec.md']
        }
      }
    
    metamodel = capability 'Semantic Metamodel' {
          description '定义 versioned element kinds、contract policies、optional containment constraints 与 relationship endpoint constraints'
          metadata {
            capabilityId 'cap.architecture.metamodel'
            status 'active'
            specs ['.opsx/specs/opsx-semantic-model/spec.md']
          }
        }
  }
}
