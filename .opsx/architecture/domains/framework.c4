model {
  framework = domain 'Framework' {
    description 'OPSX product identity and durable workspace boundary'

    metadata {
      boundary 'Owns product identity, CLI naming and the .opsx durable workspace contract'
      status 'active'
    }

    identity = capability 'Framework Identity' {
      description 'Defines the single OPSX CLI identity and hidden durable workspace contract'
      metadata {
        capabilityId 'cap.framework.identity'
        status 'active'
        specs ['.opsx/specs/opsx-framework-identity/spec.md']
      }
    }
  }
}
