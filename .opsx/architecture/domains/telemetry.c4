model {
  extend project_root {
    telemetry = domain 'Privacy Telemetry' 'Owns opt-in/opt-out anonymous operational feedback and explicitly separates it from product command behavior and user content.' {
      metadata {
        elementId 'project.root/domain.telemetry'
      }
      anonymous_usage = capability 'Anonymous Command Telemetry' 'Tracks only command identity and version with anonymous UUIDs, first-run disclosure, environment/CI opt-out, immediate flush, and silent failure.' {
        metadata {
          elementId 'cap.telemetry.anonymous-usage'
        }
      }
    }
  }
}
