model {
  schema = domain 'Schema' {
    description '定义并解析固定内置 workflow Schema，控制 artifact/file definitions、依赖关系与构建顺序'

    metadata {
      boundary '拥有 Schema YAML 解析和三层解析逻辑。不拥有制品内容生成。'
      status 'active'
    }

    opsx_delta_artifact = capability 'Opsx Delta Artifact' {
      description 'Deprecated compatibility definition for legacy opsx-delta.yaml; active spec-driven architecture artifact is architecture-delta.c4.'
      metadata {
        capabilityId 'cap.schema.opsx-delta-artifact'
        status 'deprecated'
        specs ['.opsx/specs/opsx-delta-artifact/spec.md']
      }
    }

    architecture_delta_artifact = capability 'Architecture Delta Artifact' {
      description '将 architecture-delta.c4 注册为 spec-driven 正式 architecture artifact，提供 LikeC4 template、definition-first instruction 与 staged native validation'
      metadata {
        capabilityId 'cap.schema.architecture-delta-artifact'
        status 'active'
        specs ['.opsx/changes/opsx-to-likec4-mega-refactor/specs/architecture-delta-artifact/spec.md']
      }
    }

    parse = capability 'Parse' {
      description '解析工作流 Schema YAML 文件，支持三层解析（内置、项目、变更）'
      metadata {
        capabilityId 'cap.schema.parse'
        status 'active'
      }
    }

    validate = capability 'Validate' {
      description '验证 Schema 结构和制品依赖关系'
      metadata {
        capabilityId 'cap.schema.validate'
        status 'active'
      }
    }
  }
}
