model {
  project_root = project 'OPSX' 'Human-intent programming layer that compiles Specs and LikeC4 semantic intent into agent workflows and verified project changes.' {
    metadata {
      elementId 'project.root'
    }
    ai_integration = domain 'Agent Enablement' 'Human-facing and internal agent workflow surface, tool adaptation, intent exploration, and generated workflow artifacts.' {
      metadata {
        elementId 'project.root/domain.ai_integration'
      }
      ai_intent_exploration = capability 'Intent Exploration and Impact' 'Resolves human terminology and scope, then produces evidence-backed impact observations over stable elements, contracts, and semantic relations without writing artifacts.' {
        metadata {
          elementId 'project.root/domain.ai_integration/cap.ai.intent-exploration'
        }
      }
      ai_review_roles = capability 'Agent Review Roles' 'Defines clean-context reviewer and optimizer judgment, evidence access, severity, findings, and bounded writeback responsibilities.' {
        metadata {
          elementId 'project.root/domain.ai_integration/cap.ai.review-roles'
        }
      }
      ai_snack_reconciliation = capability 'Code-First Semantic Reconciliation' 'Reconciles already-written code evidence into conditional proposal, contract, design, and architecture artifacts without inventing ownership or tasks.' {
        metadata {
          elementId 'project.root/domain.ai_integration/cap.ai.snack-reconciliation'
        }
      }
      ai_subagent_generation = capability 'Subagent Artifact Generation' 'Compiles registered internal roles into tool-native agent artifacts while preserving user-selected models and explicit access boundaries.' {
        metadata {
          elementId 'project.root/domain.ai_integration/cap.ai.subagent-generation'
        }
      }
      ai_tool_integration = capability 'AI Tool Integration' 'Defines tool-specific paths, command slugs, invocation syntax, and cross-platform adapter metadata for generated Agent artifacts.' {
        metadata {
          elementId 'project.root/domain.ai_integration/cap.ai.tool-integration'
        }
      }
      ai_workflow_generation = capability 'Agent Workflow Generation' '将 canonical workflow definitions、prompt projection、references 与 semantic guidance 编译为使用 validate preview 和 semantic diff review 的受管 Agent skills' {
        metadata {
          elementId 'project.root/domain.ai_integration/cap.ai.workflow-generation'
        }
      }
    }
    apply = domain 'Change Compilation' 'Turns approved change artifacts into implementation through evidence-gated TDD, isolation, recovery, verification, and optimization.' {
      metadata {
        elementId 'project.root/domain.apply'
      }
      apply_execution = capability 'Evidence-Gated Apply Execution' 'Executes pending checks directly with strict RED/GREEN TDD for behavior and code, coarse task decomposition, preflight consistency, and diagnostic recovery.' {
        metadata {
          elementId 'project.root/domain.apply/cap.apply.execution'
        }
      }
      apply_isolation = capability 'Apply Workspace Isolation' 'Selects and records branch, worktree, none, or ask isolation while preserving dirty-state and cross-platform file-transfer evidence.' {
        metadata {
          elementId 'project.root/domain.apply/cap.apply.isolation'
        }
      }
      apply_verification_integration = capability 'Apply Verification Integration' 'Connects implementation to reviewer judgment, finding-driven optimization, freshness, seal, and remediation without delegating Phase 0 coding to implementer.' {
        metadata {
          elementId 'project.root/domain.apply/cap.apply.verification-integration'
        }
      }
    }
    architecture = domain 'Semantic Architecture' 'Defines and reconciles the versioned OPSX metamodel, stable elements, refinement hierarchy, and typed semantic relations.' {
      metadata {
        elementId 'project.root/domain.architecture'
      }
      architecture_bootstrap = capability 'Architecture Bootstrap' 'Drives the CLI-backed init, scan, map, review, promote, refresh, and backfill lifecycle that derives a reviewed Semantic Model from repository evidence.' {
        metadata {
          elementId 'project.root/domain.architecture/cap.architecture.bootstrap'
        }
      }
      architecture_semantic_model = capability 'Versioned Semantic Model' '读取 immutable Formal snapshot，联合 materialize graph 与 contract target，验证完整 Semantic Model，并提供统一 Diff IR 与干净 formal source compilation' {
        metadata {
          elementId 'project.root/domain.architecture/cap.architecture.semantic-model'
        }
      }
    }
    artifact_graph = domain 'Artifact Compilation' 'Compiles file definitions, instructions, templates, dependencies, state, and schema projections for agent workflows.' {
      metadata {
        elementId 'project.root/domain.artifact_graph'
      }
      artifact_graph_workflow_compilation = capability 'Workflow Artifact Compilation' 'Resolves built-in workflow schema, file definitions, instruction projections, dependency order, completion state, and blocked/ready artifacts.' {
        metadata {
          elementId 'project.root/domain.artifact_graph/cap.artifact-graph.workflow-compilation'
        }
      }
    }
    change_workflow = domain 'Change Lifecycle' 'Owns change identity, discovery, metadata, creation, sync, archive, and the boundary to agent-owned Git follow-up.' {
      metadata {
        elementId 'project.root/domain.change_workflow'
      }
      change_lifecycle = capability 'Change Lifecycle Management' '维护 change 从创建、semantic diff 审阅和 verify-gated sync 到 final effective-change report、archive 与显式 Git handoff 的完整生命周期' {
        metadata {
          elementId 'project.root/domain.change_workflow/cap.change.lifecycle'
        }
      }
      change_semantic_delta = capability 'Semantic Delta Application' '编译 identity-level graph 与 Requirement operations，在 fingerprint gate 下生成 Target Semantic Model、统一 Diff IR，并以 rollback-capable transaction 原子持久化' {
        metadata {
          elementId 'project.root/domain.change_workflow/cap.change.semantic-delta'
        }
      }
    }
    cli = domain 'CLI Surface' 'Presents stable, composable OPSX commands and delegates domain behavior without becoming a second semantic source.' {
      metadata {
        elementId 'project.root/domain.cli'
      }
      cli_architecture_navigation = capability 'Architecture Navigation' '按 stable element identity 查询、验证、导出、渲染 Semantic Architecture，并提供严格非级联删除的只读影响规划' {
        metadata {
          elementId 'project.root/domain.cli/cap.cli.architecture-navigation'
        }
      }
      cli_artifact_workflow = capability 'Artifact Workflow Commands' 'One coherent command surface for status, next-artifact discovery, instructions, templates, setup, schema selection, and apply prerequisites.' {
        metadata {
          elementId 'project.root/domain.cli/cap.cli.artifact-workflow'
        }
      }
      cli_change_operations = capability 'Change Operations' '提供 change、spec、show、validate、semantic diff、sync 与 archive 命令，并通过统一 compiler 保持 preview、JSON、report 与写入语义一致' {
        metadata {
          elementId 'project.root/domain.cli/cap.cli.change-operations'
        }
      }
      cli_command_discovery = capability 'Command Discovery and Consistency' 'Derives shell completion and checks active documentation, generated prompts, and workflow references against the supported command surface.' {
        metadata {
          elementId 'project.root/domain.cli/cap.cli.command-discovery'
        }
      }
      cli_feedback = capability 'Feedback' 'Provides an explicit user feedback route without conflating feedback transport with anonymous command telemetry.' {
        metadata {
          elementId 'project.root/domain.cli/cap.cli.feedback'
        }
      }
      cli_project_setup = capability 'Project Setup and Update' 'Initializes the semantic workspace and refreshes generated agent surfaces using normalized project configuration and identity rules.' {
        metadata {
          elementId 'project.root/domain.cli/cap.cli.project-setup'
        }
      }
    }
    config = domain 'Configuration Contract' 'Owns project/global configuration, normalized projections, defaults, migration, and schema validation.' {
      metadata {
        elementId 'project.root/domain.config'
      }
      config_global_contract = capability 'Global Configuration and Migration' 'Validates global and project configuration schemas, applies backward-compatible defaults, and removes retired configuration semantics explicitly.' {
        metadata {
          elementId 'project.root/domain.config/cap.config.global-contract'
        }
      }
      config_project_settings = capability 'Project Configuration' 'Loads and validates project settings, aliases, defaults, Git policy, and apply isolation without allowing malformed configuration to halt unrelated reads.' {
        metadata {
          elementId 'project.root/domain.config/cap.config.project-settings'
        }
      }
      config_runtime_projection = capability 'Runtime Configuration Projection' 'Projects normalized prose, context, rules, Git, and apply settings into the specific workflow and artifact surfaces that consume them.' {
        metadata {
          elementId 'project.root/domain.config/cap.config.runtime-projection'
        }
      }
    }
    framework = domain 'Product Identity and Workspace' 'Defines the independent OPSX product identity, CLI naming, and durable .opsx workspace boundary.' {
      metadata {
        elementId 'project.root/domain.framework'
      }
      framework_identity = capability 'OPSX Identity Boundary' 'Maintains one OPSX CLI identity and one hidden durable workspace contract without legacy product aliases or workspace fallbacks.' {
        metadata {
          elementId 'project.root/domain.framework/cap.framework.identity'
        }
      }
    }
    migration = domain 'Semantic Model Migration' 'Converts explicitly authorized legacy inputs into a reviewed versioned OPSX candidate and verifies its promotion readiness.' {
      metadata {
        elementId 'project.root/domain.migration'
      }
      migration_semantic_model_reconciliation = capability 'Reviewed Semantic Model Reconciliation' 'Generates candidate graph, hierarchy, relations, singular Spec bindings, reports gaps, and atomically promotes only after explicit human authorization.' {
        metadata {
          elementId 'project.root/domain.migration/cap.migration.semantic-model-reconciliation'
        }
      }
    }
    opsx_element = domain 'Legacy Compatibility' 'Explicitly deprecated OPSX YAML compatibility boundary retained only long enough to complete migration and cleanup.' {
      metadata {
        elementId 'project.root/domain.opsx_element'
      }
      opsx_legacy_bundle = compatibility 'Legacy OPSX Bundle Compatibility' 'Isolates deprecated two-file OPSX YAML input as a temporary source for explicit semantic-model migration, with no active workflow ownership.' {
        metadata {
          elementId 'project.root/domain.opsx_element/compat.opsx.legacy-bundle'
        }
      }
    }
    presentation = domain 'Semantic Presentation' 'Presents the versioned graph and authorized element-owned contracts as one navigable semantic browser.' {
      metadata {
        elementId 'project.root/domain.presentation'
      }
      presentation_semantic_browser = capability 'Semantic Browser' '使用现有 LikeC4 renderer 展示 Formal 与独立 active change target variants、Requirement/Scenario diff、Architecture overlay、Diff only 与分区 diagnostics' {
        metadata {
          elementId 'project.root/domain.presentation/cap.presentation.semantic-browser'
        }
      }
    }
    quality = domain 'Delivery Assurance' 'Owns reproducible build, packaging, CI, and supported-platform checks that are outside runtime command semantics.' {
      metadata {
        elementId 'project.root/domain.quality'
      }
      quality_ci_nix_validation = capability 'Nix and Cross-Platform Delivery' 'Defines the repository\'s executable Nix package/development surface and GitHub Linux, macOS, and Windows validation matrix using the tool versions pinned by each configuration.' {
        metadata {
          elementId 'project.root/domain.quality/cap.quality.ci-nix-validation'
        }
      }
    }
    schema = domain 'Workflow Schema' 'Defines the fixed built-in workflow schemas and the artifact/file dependency semantics used by compilation.' {
      metadata {
        elementId 'project.root/domain.schema'
      }
      schema_workflow_definition = capability 'Built-in Workflow Definition' 'Parses and validates spec-driven/bootstrap schema definitions, architecture delta artifacts, dependency graphs, templates, and apply gates without fallback schemas.' {
        metadata {
          elementId 'project.root/domain.schema/cap.schema.workflow-definition'
        }
      }
    }
    telemetry = domain 'Privacy Telemetry' 'Owns opt-in/opt-out anonymous operational feedback and explicitly separates it from product command behavior and user content.' {
      metadata {
        elementId 'project.root/domain.telemetry'
      }
      telemetry_anonymous_usage = capability 'Anonymous Command Telemetry' 'Tracks only command identity and version with anonymous UUIDs, first-run disclosure, environment/CI opt-out, immediate flush, and silent failure.' {
        metadata {
          elementId 'project.root/domain.telemetry/cap.telemetry.anonymous-usage'
        }
      }
    }
    validation = domain 'Semantic Validation' 'Validates behavior contracts, frontmatter ownership, change deltas, architecture source, registry coverage, and compatibility constraints.' {
      metadata {
        elementId 'project.root/domain.validation'
      }
      validation_semantic_contract = capability 'Semantic Contract Validation' '联合验证 registry-driven singular binding、contract coverage、Requirement operations、Architecture target、strict removals 与 partial diagnostics' {
        metadata {
          elementId 'project.root/domain.validation/cap.validation.semantic-contract'
        }
      }
    }
    verify = domain 'Quality Gates' 'Provides consistency, freshness, reviewer, optimizer, finding lifecycle, and seal gates that make apply output evidence-backed.' {
      metadata {
        elementId 'project.root/domain.verify'
      }
      verify_consistency_gate = capability 'Consistency and Freshness Gate' 'Judges correctness/coherence, execution model, evidence freshness, CLI result contracts, and reviewer access before optimization or archive.' {
        metadata {
          elementId 'project.root/domain.verify/cap.verify.consistency-gate'
        }
      }
      verify_optimization_gate = capability 'Finding-Driven Optimization Gate' 'Requires optimizer invocation or a valid no-op reconciliation, persists findings and history, and drives bounded implementation waves after consistency passes.' {
        metadata {
          elementId 'project.root/domain.verify/cap.verify.optimization-gate'
        }
      }
    }
  }
}
