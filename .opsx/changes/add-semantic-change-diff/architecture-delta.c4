architectureDelta {
  ADDED {
    element 'architecture.semantic_diff_engine' {
      kind 'capability'
      parent 'architecture'
      title 'Semantic Diff Engine'
      summary '从 immutable Formal snapshot materialize selected change target，执行完整 validation 并生成统一 Diff IR'
      metadata {
        capabilityId 'cap.architecture.semantic-diff-engine'
        status 'active'
      }
    }

    element 'cli.diff' {
      kind 'capability'
      parent 'cli'
      title 'Diff'
      summary '输出 active change 的 semantic text/JSON diff，并可生成 deterministic effective-change.md'
      metadata {
        capabilityId 'cap.cli.diff'
        status 'active'
        specs ['.opsx/specs/cli-diff/spec.md']
      }
    }

    element 'cli.arch_plan_remove' {
      kind 'capability'
      parent 'cli'
      title 'Architecture Plan Remove'
      summary '分析严格非级联 element 删除中已处理与未处理的 containment、relationship 与 contract dependencies'
      metadata {
        capabilityId 'cap.cli.arch-plan-remove'
        status 'active'
        specs ['.opsx/specs/arch-plan-remove-command/spec.md']
      }
    }

    element 'presentation.change_review' {
      kind 'capability'
      parent 'presentation'
      title 'Change Review'
      summary '将统一 Diff IR 投影为 active change Specs diff、Architecture overlay、Diff only 与分区 diagnostics'
      metadata {
        capabilityId 'cap.presentation.change-review'
        status 'active'
        specs ['.opsx/specs/cli-view/spec.md', '.opsx/specs/spec-content-browser/spec.md']
      }
    }

    relationship 'architecture.semantic_diff_engine' -[invokes]-> 'architecture.likec4_reader'
    relationship 'architecture.semantic_diff_engine' -[validates]-> 'architecture.semantic_validator'
    relationship 'architecture.delta_merger' -[consumes]-> 'architecture.semantic_diff_engine'
    relationship 'cli.validate' -[invokes]-> 'architecture.semantic_diff_engine'
    relationship 'cli.diff' -[invokes]-> 'architecture.semantic_diff_engine'
    relationship 'cli.arch_plan_remove' -[invokes]-> 'architecture.semantic_diff_engine'
    relationship 'cli.archive' -[invokes]-> 'architecture.semantic_diff_engine'
    relationship 'cli.view_element' -[invokes]-> 'presentation.change_review'
    relationship 'presentation.change_review' -[consumes]-> 'architecture.semantic_diff_engine'
    relationship 'presentation.change_review' -[invokes]-> 'presentation.likec4_engine'
    relationship 'presentation.change_review' -[consumes]-> 'presentation.spec_content_gateway'
    relationship 'presentation.change_review' -[invokes]-> 'presentation.spec_content_panel'
    relationship 'ai_integration.workflow_templates' -[consumes]-> 'cli.diff'
  }

  MODIFIED {
    element 'architecture.delta_merger' {
      kind 'capability'
      parent 'architecture'
      title 'Architecture Delta Merger'
      summary '将 identity-level graph 与 contract operations 编译为完整 Target Semantic Model，并将干净 formal modules 原子写入'
      metadata {
        capabilityId 'cap.architecture.delta-merger'
        status 'active'
        specs ['.opsx/specs/architecture-delta-artifact/spec.md']
      }
    }

    element 'architecture.semantic_validator' {
      kind 'capability'
      parent 'architecture'
      title 'Semantic Validator'
      summary '联合验证 Project Root、Metamodel、identity、containment、relationships、Element Contracts 与严格非级联删除'
      metadata {
        capabilityId 'cap.architecture.semantic-validator'
        status 'active'
        specs ['.opsx/specs/likec4-semantic-validator/spec.md']
      }
    }

    element 'cli.validate' {
      kind 'capability'
      parent 'cli'
      title 'Validate'
      summary '验证 changes 与 Specs，并为 selected change 输出 diagnostics、summary 与 concise effective-change preview'
      metadata {
        capabilityId 'cap.cli.validate'
        status 'active'
      }
    }

    element 'cli.view_element' {
      kind 'capability'
      parent 'cli'
      title 'View Element'
      summary '启动具有 Formal 与所有 active change runtime model variants 的统一 Semantic Model Web 浏览器'
      metadata {
        capabilityId 'cap.cli.view'
        status 'active'
        specs ['.opsx/specs/cli-view/spec.md']
      }
    }

    element 'cli.sync' {
      kind 'capability'
      parent 'cli'
      title 'Sync'
      summary '在 verify gate 后从 immutable snapshot 编译并原子提升 graph 与 contract target modules'
      metadata {
        capabilityId 'cap.cli.sync'
        status 'active'
      }
    }

    element 'cli.archive' {
      kind 'capability'
      parent 'cli'
      title 'Archive'
      summary '在 verify、sync 与 validation gates 后生成 final effective-change.md 并封存完整 change directory'
      metadata {
        capabilityId 'cap.cli.archive'
        status 'active'
      }
    }

    element 'presentation.likec4_engine' {
      kind 'capability'
      parent 'presentation'
      title 'LikeC4 Engine'
      summary '呈现 Formal 或 selected change transient target graph，并复用现有 renderer 展示 semantic diff overlay'
      metadata {
        capabilityId 'cap.presentation.likec4-engine'
        status 'active'
      }
    }

    element 'presentation.spec_content_gateway' {
      kind 'capability'
      parent 'presentation'
      title 'Spec Content Gateway'
      summary '按 selected model variant 提供 Formal/Target Specs、registry authorization、Diff IR 与分区 diagnostics'
      metadata {
        capabilityId 'cap.presentation.spec-content-gateway'
        status 'active'
        specs ['.opsx/specs/spec-content-browser/spec.md']
      }
    }

    element 'presentation.spec_content_panel' {
      kind 'capability'
      parent 'presentation'
      title 'Spec Content Panel'
      summary '呈现 element-owned Specs 与 Requirement/Scenario semantic text diff'
      metadata {
        capabilityId 'cap.presentation.spec-content-panel'
        status 'active'
        specs ['.opsx/specs/spec-content-browser/spec.md']
      }
    }

    element 'ai_integration.workflow_templates' {
      kind 'capability'
      parent 'ai_integration'
      title 'Workflow Templates'
      summary '生成以 validate preview 与 semantic diff review 驱动的 Agent workflows，不再生成 Scenario operation labels'
      metadata {
        capabilityId 'cap.ai.workflow-templates'
        status 'active'
        specs ['.opsx/specs/opsx-framework-identity/spec.md']
      }
    }
  }

  REMOVED {
    relationship 'validation.spec' -[precedes]-> 'cli.scenario_labels'
    element 'cli.scenario_labels'
  }
}
