architectureDelta {
  MODIFIED {
    element 'change-derived-views' {
      kind 'capability'
      parent 'derived-views'
      title 'Change-derived Views'
      summary '由当前 Semantic Model 与一个活动 Change 的 Semantic Delta 确定性推导、用于呈现目标模型及语义差异的 View。它按 Change 独立建模以支持对一次演进意图的理解与审查；包含目标模型的层级浏览和 diff，不包含当前 Semantic Model 的默认浏览或 Authored View 视角。'
      metadata {
        elementId 'change-derived-views'
      }
    }
  }
}