model {
  extend project_root {
    change_workflow = domain 'Change Workflow' '管理完整变更生命周期 — 创建、增量规约操作、归档及合并到主规约' {
      metadata {
        elementId 'project.root/domain.change_workflow'
      }
      branch_merge = capability 'Branch Merge' '归档后的 git commit、merge 与 branch cleanup 由 agent 无条件继续处理；agent 先提交残余实现 diff（如有），再无条件创建 --allow-empty 的 semantic boundary commit 承载完整 change 总结（Why/Changes + Implementation footer），随后提交归档制品；message 模板按 git.commitMessage.* 路径覆盖或 .xirang/references/ 内置模板路由' {
        metadata {
          elementId 'cap.archive.branch-merge'
        }
      }
      archive = capability 'Archive' '归档已完成的变更，移动变更到 archive；archive 在校验通过后将 change 目录移入 archive，不执行 Specs 或 LikeC4 写入操作；同步合并由 xirang sync 独立完成' {
        metadata {
          elementId 'cap.change.archive'
        }
      }
      create = capability 'Create' '变更创建和管理，支持新的 explore → propose 工作流和 apply 直接执行任务模型' {
        metadata {
          elementId 'cap.change.create'
        }
      }
      discovery = capability 'Discovery' '发现和列举项目中的变更和规约' {
        metadata {
          elementId 'cap.change.discovery'
        }
      }
      metadata_element = capability 'Metadata Element' '管理变更元数据（创建时间、状态、描述）' {
        metadata {
          elementId 'cap.change.metadata'
        }
      }
      specs_sync = capability 'Specs Sync' '将 change-local graph delta 与 element-owned Spec deltas 作为一个 Semantic Delta prepare、validate、commit 或 rollback' {
        metadata {
          elementId 'cap.change.specs-sync'
        }
      }
    }
  }
}
