model {
  extend project_root {
    apply = domain 'Apply' 'apply 命令作为编译步骤，集成实现、验证、优化的完整生命周期。确保 apply 输出即验证过的制品' {
      metadata {
        elementId 'project.root/domain.apply'
      }
      branch_isolation = capability 'Branch Isolation' 'Apply 阶段分支隔离策略由 apply.defaultIsolation 驱动；main/master 上仅 ask 模式询问用户，branch/worktree/none 配置直接执行并持久化 .apply-isolation.json。' {
        metadata {
          elementId 'cap.apply.branch-isolation'
        }
      }
      preflight_scan = capability 'Preflight Scan' 'apply 执行前的 tasks.md 一致性预检，扫描 task 间矛盾（同一文件互斥声明、与 spec/design 冲突）和依赖顺序问题（前序 task 引用后序 task 的产出）；对 change-local scenario operation labels 使用 label-free scenario title 匹配 Verifies 引用' {
        metadata {
          elementId 'cap.apply.preflight-scan'
        }
      }
      recovery_protocol_enhanced = capability 'Recovery Protocol Enhanced' '增强版 Recovery Protocol，引入诊断优先（读错误→定位层面→找 working example→形成假设）、单变量修复约束和累计 3-strike 升级机制；替代原有"error signature 变化即进步"的假设' {
        metadata {
          elementId 'cap.apply.recovery-protocol-enhanced'
        }
      }
      subagent_orchestration = capability 'Subagent Orchestration' 'apply 严格区分编码与判断角色；master agent 负责 TDD 实现和有证据的 challenge，reviewer 负责正确性判断，optimizer 负责优化价值、优先级与实现级关键设计' {
        metadata {
          elementId 'cap.apply.subagent-orchestration'
        }
      }
      task_decomposition = capability 'Task Decomposition' 'Apply Phase 0 中 Master agent 直接读取 tasks.md、change-local specs、design 与项目代码上下文，但必须按 pending Check 执行严格 TDD。行为/代码 Check 需要 test first、预期失败、最小实现、通过确认后才勾选；非运行时文本制品只需最终证据；缺失断言按非运行时快速路径以 Command 输出为最终证据。失败处理遵循诊断优先、单变量修复、累计 3-strike 升级机制，不再将 error signature 变化视为进步。' {
        metadata {
          elementId 'cap.apply.task-decomposition'
        }
      }
      tdd_checkpoints = capability 'Tdd Checkpoints' 'Apply Phase 0 实现循环中的 3 个 TDD 质量检查点（接口设计可测试性、测试质量标准、Mock 边界约束）' {
        metadata {
          elementId 'cap.apply.tdd-checkpoints'
        }
      }
      verify_integration = capability 'Verify Integration' 'apply 将 Phase 1、finding-driven Phase 2 和 Phase 3 seal 串联；master agent 按 TDD 实现 selected finding，fresh optimizer 负责判断与关键设计，fresh reviewer 负责 speculative re-verify' {
        metadata {
          elementId 'cap.apply.verify-integration'
        }
      }      change_workflow = capability 'Apply Change Workflow' 'Master-agent opsx-apply-change workflow that serializes Phase 0 TDD implementation and branches into needs_verify and needs_seal clean-context verification phases.' {
        metadata {
          elementId 'cap.apply.change-workflow'
        }
      }

    }
  }
}
