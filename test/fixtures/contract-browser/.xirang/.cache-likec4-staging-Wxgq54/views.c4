views {
  view model {
    include root.browser.drill.assistant
    include root.browser.drill
    include root.browser.drill.leaf
    include root.browser.drill.peer
    include root.long
    include root.none
    include root.browser
    include root
    include root.single
  }
  view index {
    title 'Xirang Contract Browser'
    include root.none
    include root.single
    include root.long
    autoLayout LeftRight
  }
  view model_equivalent {
    title 'Model Equivalent'
    include root.browser
    include root.long
    include root.none
    include root.single
    autoLayout TopBottom
  }
}
