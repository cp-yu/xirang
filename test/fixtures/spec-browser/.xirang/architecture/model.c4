xirang {
  languageVersion '1'
}

specification {
  element project {
    xirang {
      root true
      contract optional
      children [capability]
    }
  }
  element capability {
    xirang {
      contract optional
      parents [project]
    }
  }
}

model {
  projectRoot = project 'Xirang Spec Browser' 'Browser fixture project root' {
    metadata {
      elementId 'project.root'
    }

    none = capability 'No Spec' 'Browser element without a bound Spec' {
      metadata {
        elementId 'browser.none'
      }
    }

    single = capability 'Single Spec' 'Browser element with one bound Spec' {
      metadata {
        elementId 'browser.single'
      }
    }

    multi = capability 'Multiple Specs' 'Browser element with multiple bound Specs' {
      metadata {
        elementId 'browser.multi'
      }
    }

    long = capability 'Long Spec' 'Browser element with a scrollable bound Spec' {
      metadata {
        elementId 'browser.long'
      }
    }
  }
}

views {
  view index {
    title 'Xirang Spec Browser'
    include projectRoot.*
    autoLayout LeftRight
  }
}
