model {
  architecture = domain 'Architecture' {
      description 'LikeC4 架构模型读取、语义验证和 delta 合并'
      metadata {
        boundary '拥有 LikeC4 file I/O、OpenSpec semantic validation 与 architecture delta merge'
        status 'active'
      }

      likec4_reader = capability 'LikeC4 Reader' {
        description '读取和解析 LikeC4 多文件模型'
        metadata {
          capabilityId 'cap.architecture.likec4-reader'
          status 'active'
          specs ['openspec/specs/arch-query-command/spec.md']
        }
      }

      semantic_validator = capability 'Semantic Validator' {
        description '验证 ownership、precedes cycle 与 metadata'
        metadata {
          capabilityId 'cap.architecture.semantic-validator'
          status 'active'
          specs ['openspec/specs/likec4-semantic-validator/spec.md']
        }
      }

      delta_merger = capability 'Architecture Delta Merger' {
        description '原子合并 architecture-delta.c4 到 formal LikeC4 model'
        metadata {
          capabilityId 'cap.architecture.delta-merger'
          status 'active'
          specs ['openspec/specs/architecture-delta-artifact/spec.md']
        }
      }
    }
}
