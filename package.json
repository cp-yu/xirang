{
  "name": "xirang",
  "version": "0.0.1",
  "description": "Human-intent programming framework with integrated Semantic Model and Element Contract browsing",
  "keywords": [
    "xirang",
    "semantic-model",
    "contracts",
    "cli",
    "ai",
    "development"
  ],
  "homepage": "https://github.com/cp-yu/xirang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp-yu/xirang.git"
  },
  "license": "MIT",
  "author": "Xirang Contributors",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "xirang": "./bin/xirang.js"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "likec4",
    "scripts/postinstall.js",
    "!dist/**/*.test.js",
    "!dist/**/__tests__",
    "!dist/**/*.map"
  ],
  "scripts": {
    "lint": "eslint src/",
    "build": "node build.js",
    "audit:identity": "node scripts/audit-xirang-identity.mjs",
    "likec4:install": "pnpm --dir likec4 install --frozen-lockfile",
    "likec4:build": "pnpm --dir likec4 build",
    "likec4:test": "pnpm --dir likec4 test",
    "likec4:typecheck": "pnpm --dir likec4 typecheck",
    "test:likec4": "pnpm likec4:build && vitest run test/core/likec4 test/core/view.test.ts test/integration/arch-command.test.ts",
    "dev": "tsc --watch",
    "dev:cli": "pnpm build && node bin/xirang.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:postinstall": "node scripts/postinstall.js",
    "test:pack-install": "node scripts/test-packed-install.mjs",
    "prepare": "node build.js",
    "prepublishOnly": "node build.js",
    "postinstall": "node scripts/postinstall.js",
    "check:pack-version": "node scripts/pack-version-check.mjs",
    "release": "pnpm run release:ci",
    "release:ci": "pnpm run check:pack-version && pnpm exec changeset publish",
    "changeset": "changeset"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.27.7",
    "@playwright/test": "1.60.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.39.2",
    "fast-check": "^4.6.0",
    "likec4": "1.59.0",
    "typescript-eslint": "^8.50.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@inquirer/core": "^10.2.2",
    "@inquirer/prompts": "^7.8.0",
    "@types/node": "^24.2.0",
    "chalk": "^5.5.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "ora": "^8.2.0",
    "posthog-node": "^5.20.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.2",
    "zod": "^4.0.17"
  }
}
